# Copy to .env.cloud for a LOCAL online-mode test. Use platform secrets in production.
FOLIO_PUBLIC_URL=http://127.0.0.1:4319
HOST=127.0.0.1
PORT=4319
FOLIO_DATA_DIR=./artifacts/cloud-data
# Generate with npm run cloud:setup, never commit the generated values.
FOLIO_SESSION_SECRET=
FOLIO_PASSWORD_HASH=

# Required to answer Feishu comments when every Mac is offline.
FOLIO_AI_BASE_URL=https://YOUR_PROVIDER/v1
FOLIO_AI_MODEL=YOUR_MODEL
FOLIO_AI_API_KEY=
# Optional comma-separated allowlist, defaults to FOLIO_AI_MODEL.
# FOLIO_AI_MODELS=model-one,model-two
# Optional cloud CLI executable. Authorize Feishu separately on the server.
# FOLIO_LARK_BIN=lark-cli
