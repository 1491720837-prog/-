# Copy to .env.local. Credentials stay on the local server and are never exported.
FOLIO_AI_BASE_URL=http://localhost:11434/v1
FOLIO_AI_MODEL=YOUR_INSTALLED_MODEL
# Comma-separated models selectable in the UI. Defaults to FOLIO_AI_MODEL alone.
# Every model here must support tool calling; project chat refuses the rest.
# FOLIO_AI_MODELS=model-one,model-two
# FOLIO_AI_API_KEY=YOUR_KEY
# OpenRouter example (models come from GET /api/models, key stays server-side):
# FOLIO_AI_BASE_URL=https://openrouter.ai/api/v1
# FOLIO_AI_MODEL=anthropic/claude-sonnet-5.5
# FOLIO_AI_MODELS=anthropic/claude-sonnet-5.5,deepseek/deepseek-v4.1-flash
# Optional data policy override: "deny" keeps user material out of training,
# "allow" opts in. OpenRouter hosts default to deny.
# FOLIO_AI_DATA_COLLECTION=deny
# Optional: custom Codex executable; normally detected automatically.
# FOLIO_CODEX_BIN=/path/to/codex

# Feishu sync identity for lark-cli: "user" (default, documents belong to you)
# or "bot" (app token, never needs a device-code login; requires adding the app
# to the target wiki space as an editor). Podcasts always use "user".
# FOLIO_LARK_AS=user
# FOLIO_LARK_BIN=lark-cli

# Optional: override bundled runtimes used by complete PDF / DOCX translation.
# FOLIO_PYTHON=/path/to/python3
# FOLIO_SOFFICE=/path/to/soffice
